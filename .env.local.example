# Salin file ini menjadi .env.local lalu sesuaikan.

# Koneksi MySQL Laragon (default: user root, password kosong)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_kasir_coffee

# Kunci rahasia untuk session login (ganti dengan teks acak panjang)
SESSION_SECRET=ganti-dengan-teks-acak-minimal-32-karakter-ya

# Nama toko (tampil di struk & UI)
NEXT_PUBLIC_STORE_NAME=Kedai Kopi Senja
